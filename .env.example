# ═══════════════════════════════════════════════════════════════
# SMM Manager — пример переменных окружения для продакшена
# Скопируй в .env и заполни своими значениями.
# Секреты (API-ключи) лучше хранить в Replit Secrets / Docker secrets.
# ═══════════════════════════════════════════════════════════════

# ── Окружение ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ── Домен приложения ─────────────────────────────────────────────
# Используется для формирования callback_url (webhook-адресов)
APP_URL=https://smm.omemo.tech
API_BASE_URL=https://smm.omemo.tech
PUBLIC_URL=https://smm.omemo.tech
SMM_DOMAIN=smm.omemo.tech
DOMAIN_NAME=omemo.tech

# ── Directus (Auth + CMS) ────────────────────────────────────────
DIRECTUS_URL=https://directus.nplanner.ru
DIRECTUS_ADMIN_TOKEN=your_directus_static_admin_token
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=your_directus_admin_password

# ── База данных ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/postgres

# ── AI — ключи (могут переопределяться из Directus global_api_keys) ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GOOGLE_API_KEY=AIza...
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
DEEPSEEK_API_KEY=sk-...
QWEN_API_KEY=sk-...
FAL_AI_API_KEY=your_fal_ai_key

# ── Поиск (Google Custom Search) ─────────────────────────────────
GOOGLE_SEARCH_API_KEY=AIza...
GOOGLE_SEARCH_ENGINE_ID=your_cse_id
GOOGLE_CSE_ID=your_cse_id

# ── OAuth — Google / YouTube ─────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Beget S3 (хранилище медиа) ───────────────────────────────────
BEGET_S3_ENDPOINT=https://s3.beget.com
BEGET_S3_REGION=ru-1
BEGET_S3_BUCKET=your-bucket-name
BEGET_S3_ACCESS_KEY=your_s3_access_key
BEGET_S3_SECRET_KEY=your_s3_secret_key

# ── Scraper API (217.26.25.95:3030) ──────────────────────────────
# Ключ хранится в Directus: service_name=telegram_collect_comments (или trends_scraper)
# Значение ниже — фоллбэк если Directus недоступен
SCRAPER_API_KEY_FALLBACK=c1f2e8ad-61c5-450a-b301-12690e9e1112
# Макс. одновременных каналов в одном запросе к скрейперу (не более 3 по доке)
SCRAPER_MAX_CONCURRENT=3

# ── N8N (автоматизация) ──────────────────────────────────────────
N8N_URL=https://n8n.nplanner.ru
N8N_INTERNAL_URL=http://n8n:5678
N8N_API_KEY=your_n8n_api_key
N8N_COLLECT_COMMENTS_WEBHOOK=https://n8n.nplanner.ru/webhook/collect-comments
N8N_ANALYTICS_WEBHOOK=https://n8n.nplanner.ru/webhook/analytics
N8N_TRENDS_COLLECT_WEBHOOK=https://n8n.nplanner.ru/webhook/trends-collect

# ── Telegram ─────────────────────────────────────────────────────
# Токен хранится в Directus global_api_keys; здесь — фоллбэк
# TELEGRAM_BOT_TOKEN=your_bot_token

# ── Video App (подпроект, порт 3001) ─────────────────────────────
VIDEO_APP_PORT=3001
PEXELS_API_KEY=your_pexels_api_key
HUGGINGFACE_API_KEY=your_hf_api_key
# HF_TOKEN=your_hf_token  # алиас, используется в video-app
JAMENDO_CLIENT_ID=your_jamendo_client_id

# ── ffmpeg (путь к бинарникам, если не в PATH) ───────────────────
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ── Прочее (опционально) ─────────────────────────────────────────
INTERNAL_API_KEY=your_internal_api_key
# GEMINI_PROXY_URL=http://proxy:8080
# FORCE_GEMINI_PROXY=false
# DEBUG_SCHEDULER=false
# IMGBB_API_KEY=your_imgbb_key
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_UPLOAD_PRESET=your_preset
