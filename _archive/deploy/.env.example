# ===========================================
# SSL / Let's Encrypt
# ===========================================
SSL_EMAIL=your-email@example.com

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_PASSWORD=your-secure-postgres-password

# ===========================================
# PgAdmin
# ===========================================
PASSWORD_PGADMIN=your-pgadmin-password

# ===========================================
# Directus CMS
# ===========================================
DIRECTUS_SECRET=your-directus-secret-key-min-32-chars
DIRECTUS_DB_PASSWORD=your-directus-db-password
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=your-admin-password

# ===========================================
# SMM Backend - Beget S3 Storage
# ===========================================
BEGET_S3_ACCESS_KEY=your-beget-s3-access-key
BEGET_S3_SECRET_KEY=your-beget-s3-secret-key
BEGET_S3_BUCKET=your-bucket-name
BEGET_S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
BEGET_S3_REGION=ru-1

# SMM Database
SMM_DB_NAME=smm

# Gemini API (если используется)
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# N8N Automation
# ===========================================
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-min-32-chars
GENERIC_TIMEZONE=Europe/Moscow
