# Шаблон окружения для установки SMM Manager.
#
# Копируется рядом с docker-compose.prod.yml как .env и заполняется значениями.
# Значений здесь нет и быть не должно: секреты живут только в .env на сервере.
# Список составлен по боевому /root/.env на 22.08.2026 — при добавлении новой
# переменной в прод добавляйте её и сюда, иначе вторая установка о ней не узнает.
#
# Отдельно помните: часть ключей приложение берёт НЕ отсюда, а из Directus,
# коллекция global_api_keys (16 штук), и три из них перекрывают env всегда.
# Подробности — docs/DEPLOYMENT.md, раздел «Окружение».

# ── Инфраструктура ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DIRECTUS_DB=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_STATIC_TOKEN=
DIRECTUS_URL=
DIRECTUS_PUBLIC_URL=
VITE_DIRECTUS_URL=
SSL_EMAIL=

# ── Домены ────────────────────────────────────────────────────────────────────
# SMM_HOST — канонический адрес, он же подставляется в письма, OAuth и ссылки.
# Остальные — только допустимые адреса. Нужен один домен: поставьте одинаковые.
SMM_HOST=
SMM_HOST_ALT=
SMM_HOST_ALT2=
DIRECTUS_HOST=
DIRECTUS_HOST_ALT=
VIDEO_HOST=
APP_PUBLIC_URL=
APP_EXTRA_ORIGINS=
API_BASE_URL=
LANDING_HOST=
DOMAIN_NAME=

# ── Приложение ────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
ENV=
GENERIC_TIMEZONE=
APP_SIGNING_SECRET=
ADMIN_EMAIL=
READONLY_DIAG_PASSWORD=

# ── Почта ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Оплата (ЮKassa) ───────────────────────────────────────────────────────────
# Для отдельной установки нужен свой магазин: меняются только эти значения.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PLAN_PRICE_PRO_LABEL=
VITE_PLAN_PRICE_PRO=
VITE_PLAN_PRICE_PRO_ORIGINAL=

# ── Модели и медиа ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_PROXY_URL=
FORCE_GEMINI_PROXY=
VERTEX_AI_API_KEY=
FAL_KEY=
QWEN_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Хранилище S3 (Beget) ──────────────────────────────────────────────────────
BEGET_S3_ACCESS_KEY=
BEGET_S3_SECRET_KEY=
BEGET_S3_BUCKET=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_API_IPS=

# ── Внешние интеграции ────────────────────────────────────────────────────────
SCRAPER_API_KEY=
TRENDS_WEBHOOK_SECRET=
OMEMO_POSTBACK_URL=
OMEMO_POSTBACK_SECRET=

# ── Наследие ──────────────────────────────────────────────────────────────────
# В боевом /root/.env эти две переменные есть, но ни код, ни compose их не
# читают: пароль базы берётся из POSTGRES_PASSWORD. Оставлены здесь только
# чтобы список сходился с боевым файлом; на новой установке не нужны.
DB_PASSWORD=
DIRECTUS_DB_PASSWORD=

# ── Служебное (pgadmin, только если он ставится) ──────────────────────────────
PASSWORD_PGADMIN=
PGADMIN_SUBDOMAIN=
