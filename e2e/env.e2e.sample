# Окружение E2E-стенда (AI-36). НЕ содержит боевых секретов и не должно.
#
# Принцип: всё, что ходит наружу, пустое. Даже если фоновая задача каким-то
# образом стартует, публиковать некуда, писать некому, платить нечем.
# Боевые ключи сюда не копировать никогда — стенд поднимается на localhost и
# ими не пользуется.

NODE_ENV=production
ENV=e2e
PORT=5000

# --- Directus стенда (свой, не боевой) ---
DIRECTUS_URL=http://directus-e2e:8055
VITE_DIRECTUS_URL=http://127.0.0.1:8155
DIRECTUS_ADMIN_EMAIL=e2e-admin@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME
DIRECTUS_DB=directus
DIRECTUS_STATIC_TOKEN=

# --- База стенда ---
DB_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
DIRECTUS_DB_PASSWORD=CHANGE_ME

# --- Адреса ---
APP_PUBLIC_URL=http://127.0.0.1:5100
APP_EXTRA_ORIGINS=http://localhost:5100
DOMAIN_NAME=e2e.invalid
GENERIC_TIMEZONE=Europe/Moscow

# Подпись служебных ссылок: значение своё, чтобы боевые подписи не подходили.
APP_SIGNING_SECRET=CHANGE_ME

# --- Фоновая активность выключена целиком (AI-36) ---
DISABLE_BACKGROUND_JOBS=1
ENGAGEMENT_WATCH_ENABLED=false

# --- Внешние сервисы: ПУСТО НАМЕРЕННО ---
# Соцсети и мессенджеры
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Платежи: пустой shop id означает, что оплата на стенде не создаётся
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Хранилище
BEGET_S3_ACCESS_KEY=
BEGET_S3_SECRET_KEY=
BEGET_S3_BUCKET=
# Модели и скрейперы: тесты не должны жечь лимиты и зависеть от чужой доступности
GEMINI_API_KEY=
VERTEX_AI_API_KEY=
GEMINI_PROXY_URL=
FORCE_GEMINI_PROXY=
SCRAPER_API_KEY=
# Почта: писем со стенда быть не должно
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
# Постбеки и вебхуки
OMEMO_POSTBACK_URL=
OMEMO_POSTBACK_SECRET=
# Секрет колбэков трендов: на стенде свой, чтобы боевые подписи не подходили
TRENDS_WEBHOOK_SECRET=CHANGE_ME

# --- Витрина цен (нужна клиенту при сборке/рендере) ---
VITE_PLAN_PRICE_PRO=990
VITE_PLAN_PRICE_PRO_ORIGINAL=1990
PLAN_PRICE_PRO_LABEL=Pro

# --- Пароль постгреса стенда для docker compose ---
E2E_DB_PASSWORD=CHANGE_ME
E2E_DIRECTUS_ADMIN_EMAIL=e2e-admin@example.com
E2E_DIRECTUS_ADMIN_PASSWORD=CHANGE_ME
E2E_DIRECTUS_SECRET=CHANGE_ME
