{
  "name": "Publish VK Clips",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-vk-clips",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.DIRECTUS_URL}}/items/campaign_content/{{$json.body.contentId}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-content",
      "name": "Get Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "directus-auth",
          "name": "Directus Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.DIRECTUS_URL}}/items/campaigns/{{$json.data.campaign_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-campaign",
      "name": "Get Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "directus-auth",
          "name": "Directus Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"contentId\": \"{{ $node['Webhook'].json.body.contentId }}\",\n  \"title\": \"{{ $node['Get Content'].json.data.title }}\",\n  \"description\": \"{{ $node['Get Content'].json.data.content }}\",\n  \"videoUrl\": \"{{ $node['Get Content'].json.data.video_url }}\",\n  \"groupId\": \"{{ $node['Get Campaign'].json.data.social_settings.vk.groupId }}\",\n  \"accessToken\": \"{{ $node['Get Campaign'].json.data.social_settings.vk.token }}\"\n}",
        "options": {}
      },
      "id": "prepare-data",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 300]
