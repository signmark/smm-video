    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vk.com/method/video.save",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "group_id",
              "value": "={{ $json.groupId.replace('club', '').replace('-', '') }}"
            },
            {
              "name": "name",
              "value": "={{ $json.title }}"
            },
            {
              "name": "description",
              "value": "={{ $json.description.substring(0, 500) }}"
            },
            {
              "name": "is_private",
              "value": "0"
            },
            {
              "name": "wallpost",
              "value": "0"
            },
            {
              "name": "access_token",
              "value": "={{ $json.accessToken }}"
            },
            {
              "name": "v",
              "value": "5.199"
            }
          ]
        },
        "options": {}
      },
      "id": "vk-video-save",
      "name": "VK video.save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $node['Prepare Data'].json.videoUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-video",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['VK video.save'].json.response.upload_url }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "video_file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "upload-video",
      "name": "Upload Video to VK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vk.com/method/wall.post",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "owner_id",
              "value": "=-{{ $node['Prepare Data'].json.groupId.replace('club', '').replace('-', '') }}"
            },
            {
              "name": "message",
              "value": "={{ $node['Prepare Data'].json.description }}"
            },
            {
              "name": "attachments",
              "value": "=video{{ $node['VK video.save'].json.response.owner_id }}_{{ $node['VK video.save'].json.response.video_id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $node['Prepare Data'].json.accessToken }}"
            },
            {
              "name": "v",
              "value": "5.199"
            }
          ]
        },
        "options": {}
      },
      "id": "vk-wall-post",
      "name": "VK wall.post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.DIRECTUS_URL}}/items/campaign_content/{{ $node['Webhook'].json.body.contentId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "published"
            },
            {
              "name": "published_at",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "post_url",
              "value": "=https://vk.com/wall-{{ $node['Prepare Data'].json.groupId.replace('club', '').replace('-', '') }}_{{ $node['VK wall.post'].json.response.post_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "update-directus",
      "name": "Update Directus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "directus-auth",
          "name": "Directus Auth"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"postId\": {{ $node['VK wall.post'].json.response.post_id }},\n  \"postUrl\": \"https://vk.com/wall-{{ $node['Prepare Data'].json.groupId.replace('club', '').replace('-', '') }}_{{ $node['VK wall.post'].json.response.post_id }}\",\n  \"videoId\": {{ $node['VK video.save'].json.response.video_id }}\n}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1980, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"{{ $json.error ? $json.error.error_msg : 'Unknown error' }}\"\n}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1980, 600]
    }
