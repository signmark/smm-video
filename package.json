{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "SMM Manager - Social Media Management Platform",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:server": "nodemon --watch 'server/**/*.ts' --exec \"node --loader ts-node/esm\" server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --external:pg-native --external:cpu-features --external:@swc/core --external:esbuild --external:vite --external:./vite.js --external:canvas --packages=external",
    "start": "NODE_ENV=production node dist/server/index.js",
    "start:windows": "set NODE_ENV=production && node dist/index.js",
    "check": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:unit": "vitest run --exclude=**/auth_flow.test.ts --exclude=**/api_routes_new.test.ts --exclude=**/STORY_FLOW.test.ts --exclude=**/BUSINESS_SURVEY_REAL.test.ts --exclude=**/GEMINI_FINAL_CHECK.test.ts",
    "test:coverage:vitest": "vitest run --coverage --exclude=**/auth_flow.test.ts --exclude=**/api_routes_new.test.ts --exclude=**/STORY_FLOW.test.ts --exclude=**/BUSINESS_SURVEY_REAL.test.ts --exclude=**/GEMINI_FINAL_CHECK.test.ts",
    "test:jest": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:ai": "NODE_ENV=test jest --testPathPattern=autonomous-ai",
    "test:integration": "NODE_ENV=test jest --testPathPattern=integration",
    "test:e2e": "NODE_ENV=test jest --testPathPattern=e2e",
    "test:e2e:video": "cd video-app && npx tsx --test e2e/video-generator.e2e.ts",
    "test:e2e:video:fast": "cd video-app && SKIP_SLOW=1 npx tsx --test e2e/video-generator.e2e.ts",
    "test:e2e:video:full": "cd video-app && npx tsx --test e2e/video-generator.e2e.ts",
    "test:quality:video": "cd video-app && npx tsx --test e2e/video-quality.e2e.ts",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:smm": "playwright test smm-flow",
    "test:playwright:smm:headed": "playwright test smm-flow --headed",
    "test:unit": "NODE_ENV=test jest --testPathPattern=__tests__ --testPathIgnorePatterns=integration,e2e",
    "test:ci": "NODE_ENV=test jest --ci --coverage --watchAll=false",
    "test:debug": "NODE_ENV=test node --inspect-brk node_modules/.bin/jest --runInBand",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
