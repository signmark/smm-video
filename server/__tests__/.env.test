# Тестовое окружение для unit-тестов (vitest.config.ts → setup.ts).
#
# Значения ЗАВЕДОМО ФИКТИВНЫЕ и не ведут к реальным сервисам. Файл закоммичен,
# чтобы `npx vitest run` был зелёным на любой машине без ручной подготовки —
# в частности на прод-хосте, где корневого `/root/smm/.env` нет (глобальные
# креды лежат в `/root/.env` и монтируются в контейнер через env_file).
#
# Тесты, которым нужен настоящий Directus/внешнее API, ОБЯЗАНЫ мокать сеть
# (vi.mock('axios'), vi.stubGlobal('fetch', ...)), а не ходить наружу.
# Реальные интеграционные тесты используют отдельный setup.integration.ts.

# Directus: URL и admin-токены. Наличие токена нужно, чтобы код шёл по
# «есть admin-токен» пути (профиль, гейт админа, прямая публикация), где
# сеть замокана — иначе он сваливается в реальный /auth/login и ломает
# выравнивание mockResolvedValueOnce у axios.
DIRECTUS_URL=http://directus.test
DIRECTUS_STATIC_TOKEN=test-static-admin-token
DIRECTUS_ADMIN_TOKEN=test-admin-token
DIRECTUS_TOKEN=test-admin-token
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=test-admin-password
