{
  "name": "video-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "node --experimental-vm-modules node_modules/.bin/tsx server/index.ts",
    "test:e2e": "npx tsx --test e2e/video-generator.e2e.ts",
    "test:e2e:fast": "SKIP_SLOW=1 npx tsx --test e2e/video-generator.e2e.ts",
    "test:e2e:generate": "npx tsx --test e2e/video-generator.e2e.ts",
    "test:quality": "npx tsx --test e2e/video-quality.e2e.ts",
    "test:quality:existing": "npx tsx --test e2e/video-quality.e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@types/pg": "^8.20.0",
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "msedge-tts": "^2.0.6",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "typescript": "5.6.3",
    "vite": "^5.4.14"
  }
}
